archetype (adl_version=1.4; uid=92812e48-b472-4f0f-8acd-730161741f47)
	openEHR-EHR-OBSERVATION.complementary_test_result.v0

concept
	[at0000]	-- Complementary test result
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["ca"] = <
			language = <[ISO_639-1::ca]>
			author = <
