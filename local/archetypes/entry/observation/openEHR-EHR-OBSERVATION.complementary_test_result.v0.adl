description
	original_author = <
		["name"] = <"Tara Bonet, Ana Pascual, Clara Calleja, Laura Moral, Martin Koch, David Hernández, Hugo Briceño, David Alonso,  Lluis Valle">
		["organisation"] = <"Modelatge del Coneixement Clínic Catsalut ">
		["email"] = <"ckm.salut@gencat.cat">
		["date"] = <"2025-11-10">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"	
To record the findings on an examination of a specified body structure or region and their interpretation, using techniques not included in specific observation examinations.">
			use = <"Use to record the findings on examination of a specified body structure or region and their interpretation, using techniques not included in specific observation examinations such as OBSERVATION.imaging_exam_result or openEHR-EHR-OBSERVATION.laboratory_test_result.v1.">
			keywords = <"diagnosis", "diagnostic", "test", "result", "examination">
			misuse = <"Not to be used to record findings on physical or imaging examination. Use the CLUSTER.exam, OBSERVATION.imaging_exam_result and/or their family of specialised archetypes for this purpose.
Not to be used to record laboratory test results. Use openEHR-EHR-OBSERVATION.laboratory_test_result.v1 for this purpose.">
			copyright = <"© Departament de Salut de la Generalitat de Catalunya">
		>
		["ca"] = <
			language = <[ISO_639-1::ca]>
			purpose = <"">
			use = <"">
			misuse = <"">
			copyright = <"© Departament de Salut de la Generalitat de Catalunya">
		>
		["es"] = <
			language = <[ISO_639-1::es]>
			purpose = <"">
			use = <"">
			misuse = <"">
			copyright = <"© Departament de Salut de la Generalitat de Catalunya">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <>
	other_details = <
